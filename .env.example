# Copy to .env and populate locally; never commit .env
PINATA_JWT=replace_with_secret_pinata_jwt
AMOY_RPC_URL=https://your-amoy-rpc-provider.example
INSTITUTION_REGISTRY_ADDRESS=0xYourDeployedV1InstitutionRegistryAddress
PORT=8085
# Optional: custom Pinata gateway, including https://
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Institution map stored in a server-only JSON file (never public web root)
CERTIVERF_INSTITUTIONS_FILE=./private/institutions.json
CERTIVERF_INVENTORY_FILE=./private/inventory.jsonl
