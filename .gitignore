# 1. Node.js dependencies
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/

# 2. Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.keystore
*.secret
secrets/
private-keys/
credentials/

# 3. Hardhat compilation outputs
artifacts/
cache/
typechain/
typechain-types/
coverage/
coverage.json
*.tsbuildinfo

# 4. Solidity testing and gas reports
gas-report.txt
gas-report.json
test-results/
hardhat-test-results.txt
hardhat-test-results-*.txt
.nyc_output/

# 5. The Graph generated and build outputs
**/generated/
**/build/
**/.graphclient/
**/.graph/
**/subgraph.yaml.bak

# 5.1 The Graph local development outputs
private/
audit-exports/

# 6. Frontend build outputs
dist/
.next/
.nuxt/
out/
.vercel/
.netlify/
.turbo/
.parcel-cache/
.vite/
storybook-static/

# 7. Temporary files and logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*~

# 8. Python analysis environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# 9. Operating system files
.DS_Store
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# 10. Editor and IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.code-workspace

# 11. Local blockchain and development state
chain-data/
blockchain-data/
.local-chain/
anvil-state.json
deployments/local/
deployments/localhost/
deployments/hardhat/

# 12. Temporary research and exported datasets
tmp/
temp/
scratch/
*.zip
*.7z
*.rar

